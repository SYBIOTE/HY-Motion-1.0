# HY-Motion shared base image (RunPod branch — slim; checkpoints live on a network volume).
# CUDA runtime, Python 3.11, uv, PyTorch, shared deps, entrypoint + ensure_checkpoints.
#
# Build:
#   docker build -f Dockerfile.base -t hymotion-base .
#
# Weights are not baked in; mount a RunPod network volume (or S3-sync) and set CKPTS_ROOT / MODEL_PATH.

ARG CUDA_VERSION=12.4.1
FROM nvidia/cuda:${CUDA_VERSION}-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.11 python3.11-venv python3-pip curl \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/python3.11 /usr/bin/python3 \
    && ln -sf /usr/bin/python3 /usr/bin/python

RUN pip install uv

WORKDIR /app

COPY docker-entrypoint.sh /app/docker-entrypoint.sh
COPY scripts/ensure_checkpoints.py /app/scripts/ensure_checkpoints.py
RUN chmod +x /app/docker-entrypoint.sh

COPY requirements-torch.txt .
RUN uv pip install --system --no-cache -r requirements-torch.txt

COPY requirements-base.txt .
RUN uv pip install --system --no-cache -r requirements-base.txt

COPY hymotion/ hymotion/
COPY stats/ stats/

ENV CKPTS_ROOT=/app/ckpts \
    MODEL_PATH=/app/ckpts/tencent/HY-Motion-1.0-Lite \
    QWEN_QUANTIZATION=int4 \
    DISABLE_PROMPT_ENGINEERING=True \
    USE_HF_MODELS=0 \
    MMGP_PROFILE=1 \
    MMGP_VERBOSE=1 \
    PORT=8080 \
    AUTO_DOWNLOAD_CKPTS=1

ENTRYPOINT ["/app/docker-entrypoint.sh"]
